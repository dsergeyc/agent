# Anthropic Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# Telegram Bot token from @BotFather — https://t.me/BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdef...

# Your channel username (with @) or numeric ID (e.g. @SiliconValleyDesigner or -1001234567890)
TELEGRAM_CHANNEL_ID=@YourChannelUsername

# Unsplash API key for post images (optional — free at unsplash.com/developers)
# Without this, posts are sent as text only
UNSPLASH_ACCESS_KEY=

# How often to post: cron expression (default = 10:00 AM Moscow time, Mon/Wed/Fri)
POST_SCHEDULE=0 7 * * 1,3,5
