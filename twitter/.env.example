# Anthropic Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# X (Twitter) API credentials — https://developer.twitter.com/en/portal/dashboard
# Your app needs "Read and Write" permissions
X_API_KEY=...
X_API_SECRET=...
X_ACCESS_TOKEN=...
X_ACCESS_TOKEN_SECRET=...

# Cron schedule (default = 10am and 7pm Moscow time daily)
POST_SCHEDULE=0 7,16 * * *
